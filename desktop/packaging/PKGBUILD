# Maintainer: akuras22
pkgname=hestundenplan-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Stundenplan der Hochschule Esslingen für Linux (GNOME, KDE Plasma und andere)"
arch=('x86_64')
url="https://github.com/akuras22/HEStundenplanApp"
license=('GPL3')
# Ship one plain package — a split "-debug" package (this system's default) would leave two
# *.pkg.tar.zst files behind, which breaks any tooling (including our own CI) that expects a
# single build artifact to pick up.
options=('!debug')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'kirigami' 'kconfig' 'kcoreaddons' 'ki18n'
         'knotifications' 'kdbusaddons' 'libxml2'
         # The app has two looks (see src/core/DesktopStyle.h) and each needs an icon theme, and
         # the KDE one a style, that kirigami itself doesn't pull in:
         # - adwaita-icon-theme: every icon of the GNOME look (the default outside Plasma) is one
         #   of Adwaita's "-symbolic" icons.
         # - breeze-icons: the KDE look's toolbar/nav icon names (view-calendar-day,
         #   go-jump-today, configure, documentinfo, ...) only exist in Breeze.
         # - qqc2-desktop-style: provides the "org.kde.desktop" QQC2 style the KDE look selects;
         #   without this package present the app would fail to start under Plasma.
         'adwaita-icon-theme' 'breeze-icons' 'qqc2-desktop-style')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'git')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/HEStundenplanApp"
  git rev-list --count HEAD
}

build() {
  # APP_VERSION_CODE/APP_VERSION_NAME are set by CI (to github.run_number and the release title)
  # when packaging an official release, so the in-app OTA-update check and the "Über die App"
  # version string have something real to work with; local/AUR builds default to 0/"dev".
  cmake -S "${srcdir}/HEStundenplanApp/desktop" -B build \
    -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DAPP_VERSION_CODE="${APP_VERSION_CODE:-0}" \
    -DAPP_VERSION_NAME="${APP_VERSION_NAME:-dev}"
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
